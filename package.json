{
  "name": "reader-desktop",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Word 风格的本地 TXT 阅读器",
  "author": "Reader",
  "license": "MIT",
  "homepage": "https://github.com/SuperSaiyanJcy/reader#readme",
  "repository": { "type": "git", "url": "git+https://github.com/SuperSaiyanJcy/reader.git" },
  "bugs": { "url": "https://github.com/SuperSaiyanJcy/reader/issues" },
  "engines": { "node": ">=22.12.0" },
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run notices && tsc --noEmit && vite build",
    "notices": "node scripts/generate-notices.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "pack:mac": "npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "pack:win": "npm run build && electron-builder --win nsis zip --x64 --publish never",
    "pack:win:zip": "npm run build && electron-builder --win zip --x64 --publish never"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.24",
    "iconv-lite": "0.7.3",
    "jschardet": "4.1.0",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "local.reader.document",
    "productName": "Reader",
    "artifactName": "Reader-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "release", "buildResources": "resources" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraResources": [
      { "from": "resources/示例小说.txt", "to": "示例小说.txt" },
      { "from": "resources/THIRD_PARTY_NOTICES.txt", "to": "THIRD_PARTY_NOTICES.txt" },
      { "from": "LICENSE", "to": "LICENSE.Reader.txt" }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["arm64"] }, { "target": "zip", "arch": ["arm64"] }],
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "resources/icon.icns",
      "minimumSystemVersion": "13.0"
    },
    "dmg": { "title": "Reader", "window": { "width": 540, "height": 360 } },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "zip", "arch": ["x64"] }],
      "icon": "resources/icon.ico",
      "signExecutable": false
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Reader", "deleteAppDataOnUninstall": false }
  }
}
